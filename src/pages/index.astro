---
import Layout from '../layouts/Layout.astro';

const links = [
  { label: "Blog", href: "https://paragraph.com/@susanagomes@cachicamo.studio", rel: "noreferrer" },
  { label: "Mastodon", href: "https://mastodon.social/@susanagomes", rel: "me noreferrer" },
];
---

<Layout title="Susana Gomes">
  <section class="hero">
    <!-- Background Image -->
    <img
      src="/hero.png"
      alt="Susana Gomes"
      class="hero-bg"
    />

    <!-- Dark overlay -->
    <div style="position: absolute; inset: 0; background: rgba(0,0,0,0.2); z-index: 1;"></div>

    <header class="topbar">
      <a class="brand" href="/">Susana Gomes</a>
      <a class="toplink" href="/about">About</a>
    </header>
    <div class="hero-content">
      <h1 class="hero-text">
        construyendo mi<br />
        propio<br />
        universo digital.
      </h1>
    </div>

    <!-- Scroll hint -->
    <div class="scroll-hint" aria-hidden="true">↓</div>
  </section>

  <!-- Glitch overlay -->
  <div class="glitch-overlay" aria-hidden="true"></div>

  <!-- Nixie strip divider -->
  <div class="nixie-strip" aria-hidden="true">
    <pre class="nixie-chars" id="nixieChars"></pre>
  </div>

  <!-- Muy pronto section -->
  <section class="pronto-section">
    <img src="/caminata-espacial.png" alt="" class="pronto-bg" />
    <div class="pronto-overlay"></div>
    <div class="pronto-content">
      <h2 class="pronto-text">muy pronto.</h2>
    </div>
    <nav class="pronto-links" aria-label="Links principales">
      <a class="pill" href="https://paragraph.com/@susanagomes@cachicamo.studio" target="_blank" rel="noreferrer">
        Blog
        <span class="underline" aria-hidden="true"></span>
      </a>
      <a class="pill" href="https://mastodon.social/@susanagomes" target="_blank" rel="me noreferrer">
        Mastodon
        <span class="underline" aria-hidden="true"></span>
      </a>
    </nav>
  </section>
</Layout>

<style>
@font-face {
  font-family: 'Last Day On Earth';
  src: url('/fonts/LastDayOnEarth.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

.hero {
  height: 100vh;
  scroll-snap-align: start;
  position: relative;
  display: grid;
  align-items: center;
  padding: 28px;
  overflow: hidden;
}
/* Background image with zoom animation */
.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
  animation: slowZoom 20s ease-in-out infinite alternate;
}
@keyframes slowZoom{
  from { transform: scale(1); }
  to   { transform: scale(1.05); }
}
/* Top bar */
.topbar{
  position: absolute;
  top: 20px;
  left: 20px;
  right: 20px;
  display:flex;
  justify-content: space-between;
  align-items:center;
  z-index: 2;
}
.brand{
  font-family: 'nickel-gothic-variable', sans-serif;
  font-size: 48px;
  font-weight: 400;
  font-style: normal;
  font-variation-settings: 'slnt' 0;
  letter-spacing: 1px;
  opacity: 0;
  transform: translateY(-6px);
  animation: brandIn 900ms ease forwards;
  animation-delay: 120ms;
  text-decoration: none;
  color: white;
  transition: opacity 300ms ease;
}
.brand:hover{
  opacity: 0.8;
}
@keyframes brandIn{
  to { opacity: 1; transform: translateY(0); }
}
.toplink{
  font-family: 'oxanium', sans-serif;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  opacity: 0.85;
  text-decoration: none;
  color: rgba(255,255,255,0.85);

  /* Glassmorphism */
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(10px) saturate(180%);
  -webkit-backdrop-filter: blur(10px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.2);
  padding: 8px 16px;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.15);
  transition: all 300ms ease;
}
.toplink:hover{
  background: rgba(255, 255, 255, 0.15);
  border-color: rgba(255, 255, 255, 0.35);
  opacity: 1;
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.25);
}
/* Hero text entrance */
.hero-content{
  position: absolute;
  bottom: 70px;
  right: 40px;
  z-index: 2;
  max-width: 600px;
  text-align: right;
}
.hero-text{
  opacity: 0;
  transform: translateY(12px);
  animation: fadeUp 1200ms cubic-bezier(.2,.8,.2,1) forwards;
  animation-delay: 260ms;
  font-family: 'strelka', sans-serif;
  font-size: clamp(26px, 3.2vw, 48px);
  line-height: 1.0;
  font-weight: 900;
  font-style: normal;
  letter-spacing: -0.5px;
  color: #ffffff;
}
@keyframes fadeUp{
  to { opacity: 1; transform: translateY(0); }
}
/* Bottom left links */
.bottom-links{
  position: absolute;
  left: 20px;
  bottom: 20px;
  display:flex;
  gap: 10px;
  z-index: 2;
  opacity: 0;
  transform: translateY(8px);
  animation: bottomIn 900ms ease forwards;
  animation-delay: 520ms;
}
@keyframes bottomIn{
  to { opacity: 1; transform: translateY(0); }
}
.pill{
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 11px 22px;
  border-radius: 999px;
  font-family: 'oxanium', sans-serif;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  text-decoration: none;
  color: rgba(255, 255, 255, 0.95);

  /* Apple liquid glass */
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px) saturate(180%) brightness(1.1);
  -webkit-backdrop-filter: blur(20px) saturate(180%) brightness(1.1);
  border: 1px solid rgba(255, 255, 255, 0.25);
  box-shadow:
    0 2px 8px rgba(0, 0, 0, 0.15),
    0 8px 32px rgba(0, 0, 0, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.35),
    inset 0 -1px 0 rgba(255, 255, 255, 0.05);
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
}
.pill-icon {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
  opacity: 0.85;
}
.pill:hover{
  transform: translateY(-2px) scale(1.02);
  background: rgba(255, 255, 255, 0.14);
  border-color: rgba(255, 255, 255, 0.4);
  box-shadow:
    0 4px 16px rgba(0, 0, 0, 0.2),
    0 12px 40px rgba(0, 0, 0, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.5),
    inset 0 -1px 0 rgba(255, 255, 255, 0.08);
}
/* underline animation */
.pill .underline{
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: 6px;
  height: 1px;
  background: rgba(255,255,255,0.75);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 260ms ease;
  opacity: 0.8;
}
.pill:hover .underline{
  transform: scaleX(1);
}
/* Mobile responsive */
@media (max-width: 600px) {
  .hero {
    padding: 20px;
  }
  .topbar {
    top: 16px;
    left: 16px;
    right: 16px;
  }
  .brand {
    font-size: 32px;
    letter-spacing: 1px;
  }
  .toplink {
    font-size: 14px;
    padding: 6px 12px;
  }
  .hero-content {
    bottom: 120px;
    right: 16px;
    left: 16px;
    max-width: 100%;
    text-align: right;
  }
  .hero-text {
    font-size: clamp(22px, 7vw, 36px);
    line-height: 1.0;
  }
  .bottom-links {
    left: 16px;
    bottom: 16px;
    gap: 8px;
  }
  .pill {
    font-size: 13px;
    padding: 9px 16px;
  }
  .scroll-hint {
    display: none;
  }
}

/* Scroll hint */
.scroll-hint{
  position: absolute;
  left: 50%;
  bottom: 24px;
  transform: translateX(-50%);
  z-index: 2;
  animation: pulse 1.8s ease-in-out infinite;

  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 64px;
  border-radius: 999px;
  font-size: 22px;
  color: rgba(255, 255, 255, 0.9);

  /* Liquid glass */
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px) saturate(180%) brightness(1.1);
  -webkit-backdrop-filter: blur(20px) saturate(180%) brightness(1.1);
  border: 1px solid rgba(255, 255, 255, 0.22);
  box-shadow:
    0 2px 8px rgba(0, 0, 0, 0.15),
    0 8px 32px rgba(0, 0, 0, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.35),
    inset 0 -1px 0 rgba(255, 255, 255, 0.05);
}
@keyframes pulse{
  0%,100%{ transform: translateX(-50%) translateY(0); opacity: .7; }
  50%{ transform: translateX(-50%) translateY(6px); opacity: 1; }
}

/* ── Glitch transition ─────────────────────── */
.glitch-overlay {
  position: fixed;
  inset: 0;
  z-index: 200;
  pointer-events: none;
  opacity: 0;
}

.glitch-overlay.active {
  animation: glitchOverlay 0.45s steps(1) forwards;
}

@keyframes glitchOverlay {
  0%   { opacity: 0; background: transparent; }
  7%   { opacity: 1;
         background:
           repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.4) 3px, rgba(0,0,0,0.4) 6px),
           rgba(255,0,60,0.22);
         transform: translateX(-6px); }
  14%  { opacity: 1;
         background:
           repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.4) 3px, rgba(0,0,0,0.4) 6px),
           rgba(0,255,220,0.2);
         transform: translateX(6px); }
  21%  { opacity: 0; transform: translateX(0); }
  28%  { opacity: 1;
         background: rgba(255,255,255,0.06);
         transform: translateX(-10px) scaleX(1.015); }
  35%  { opacity: 0; transform: translateX(0); }
  45%  { opacity: 1;
         background:
           repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.5) 2px, rgba(0,0,0,0.5) 4px),
           rgba(255,0,60,0.14);
         transform: translateX(8px); }
  52%  { opacity: 0; }
  62%  { opacity: 1;
         background: rgba(0,255,220,0.1);
         transform: translateX(-4px); }
  70%  { opacity: 0; }
  100% { opacity: 0; }
}

.hero.glitching,
.pronto-section.glitching {
  animation: glitchShake 0.45s steps(1) forwards;
}

@keyframes glitchShake {
  0%   { transform: translate(0) scale(1);
         filter: none; }
  10%  { transform: translate(-9px, 3px) scale(1.01);
         filter: brightness(1.5)
                 drop-shadow(6px  0 0 rgba(255,0,60,1))
                 drop-shadow(-6px 0 0 rgba(0,255,220,1)); }
  20%  { transform: translate(9px, -3px) scale(0.99);
         filter: brightness(0.6)
                 drop-shadow(-8px 0 0 rgba(255,0,60,0.9))
                 drop-shadow(8px  0 0 rgba(0,255,220,0.9)); }
  30%  { transform: translate(-5px, 0) scale(1);
         filter: brightness(1.3)
                 drop-shadow(4px  0 0 rgba(255,0,60,0.7))
                 drop-shadow(-4px 0 0 rgba(0,255,220,0.7)); }
  40%  { transform: translate(5px, 0);
         filter: none; }
  50%  { transform: translate(-3px, 2px);
         filter: drop-shadow(5px  0 0 rgba(255,0,60,0.6))
                 drop-shadow(-5px 0 0 rgba(0,255,220,0.6)); }
  60%  { transform: translate(3px, -2px);
         filter: brightness(1.2); }
  70%  { transform: translate(-2px, 0);
         filter: none; }
  85%  { transform: translate(2px, 0); }
  100% { transform: translate(0) scale(1);
         filter: none; }
}

/* ── Nixie strip divider ─────────────────────────── */
.nixie-strip {
  width: 100%;
  height: 42px;
  overflow: hidden;
  position: relative;
  background: #060d08;
  /* Stroke gris espacial — da el look de screen delgada */
  border-top:    1px solid rgba(148, 162, 152, 0.55);
  border-bottom: 1px solid rgba(148, 162, 152, 0.55);
  box-shadow:
    0 -3px 8px rgba(0, 0, 0, 0.7),
    0  3px 8px rgba(0, 0, 0, 0.7),
    inset 0  1px 0 rgba(255, 255, 255, 0.05),
    inset 0 -1px 0 rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
}
/* Reflejo verdoso en esquina superior derecha */
.nixie-strip::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 90% -20%, rgba(70, 160, 90, 0.18) 0%, transparent 50%),
    linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 0%, transparent 60%);
  pointer-events: none;
  z-index: 2;
}
.nixie-chars {
  position: relative;
  z-index: 1;
  margin: 0;
  padding: 0 16px;
  font-family: 'Courier New', 'Courier', monospace;
  font-size: 11px;
  line-height: 1;
  letter-spacing: 2.5px;
  color: #e8a828;
  text-shadow:
    0 0 3px rgba(232, 168, 40, 1),
    0 0 9px rgba(232, 168, 40, 0.65),
    0 0 20px rgba(232, 168, 40, 0.25);
  white-space: nowrap;
  overflow: hidden;
  width: 100%;
  pointer-events: none;
  user-select: none;
}

/* Muy pronto section */
.pronto-section {
  height: 100vh;
  scroll-snap-align: start;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.pronto-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
  animation: slowZoom 20s ease-in-out infinite alternate;
}
.pronto-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1;
}
.pronto-content {
  position: absolute;
  z-index: 2;
  right: 22%;
  top: 52%;
  transform: translateY(-50%);
  text-align: right;
}
.pronto-links {
  position: absolute;
  right: 20px;
  bottom: 20px;
  display: flex;
  gap: 10px;
  z-index: 3;
  opacity: 0;
  transform: translateY(8px);
  animation: bottomIn 900ms ease forwards;
  animation-delay: 520ms;
}
.pronto-text {
  font-family: 'strelka', sans-serif;
  font-size: clamp(26px, 3.2vw, 48px);
  font-weight: 900;
  line-height: 1;
  letter-spacing: -0.5px;
  color: #ffffff;
  margin: 0;
}
</style>

<script>
  const scroller = document.documentElement;
  const hero    = document.querySelector('.hero')           as HTMLElement;
  const pronto  = document.querySelector('.pronto-section') as HTMLElement;
  const overlay = document.querySelector('.glitch-overlay') as HTMLElement;

  let glitching = false;

  function triggerGlitch() {
    if (glitching) return;
    glitching = true;

    // Fuerza reflow para reiniciar animación
    overlay.classList.remove('active');
    hero.classList.remove('glitching');
    pronto.classList.remove('glitching');
    void overlay.offsetWidth;

    overlay.classList.add('active');
    hero.classList.add('glitching');
    pronto.classList.add('glitching');

    setTimeout(() => {
      overlay.classList.remove('active');
      hero.classList.remove('glitching');
      pronto.classList.remove('glitching');
      glitching = false;
    }, 500);
  }

  document.body.addEventListener('scroll', triggerGlitch, { passive: true });

  // ── Nixie strip ────────────────────────────────────────────────────────────
  (function() {
    const el = document.getElementById('nixieChars');
    if (!el) return;

    // Dígitos con mucho peso (efecto tubo Nixie contando), algunos símbolos retro
    const POOL =
      '0123456789' +
      '0123456789' +
      '0123456789' +
      '0123456789' +
      ':.-_|/\\≠∞∑';

    function rnd(s: string) {
      return s[Math.floor(Math.random() * s.length)];
    }

    // Calcular cuántas columnas caben
    const availW = (el.parentElement?.clientWidth ?? 1200) - 32;
    const COLS   = Math.max(50, Math.floor(availW / 9));

    // Cada columna: valor actual + velocidad de conteo
    const cols = Array.from({ length: COLS }, () => ({
      v: Math.floor(Math.random() * POOL.length),  // índice actual en POOL
      s: Math.floor(Math.random() * 5) + 1,         // speed: 1 (rápido) – 5 (lento)
      f: Math.floor(Math.random() * 5),              // frame offset para desfase
    }));

    let frame = 0;

    function tick() {
      frame++;
      let row = '';
      for (const c of cols) {
        if (frame % c.s === c.f % c.s) {
          c.v = (c.v + 1) % POOL.length;
        }
        row += POOL[c.v];
      }
      el.textContent = row;
    }

    setInterval(tick, 55); // ~18 fps
  })();
</script>